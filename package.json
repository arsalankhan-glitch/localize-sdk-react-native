{
  "name": "@adres/react-native-localize-sdk",
  "version": "0.1.0",
  "description": "React Native SDK for fetching localization keys from the Localize API.",
  "license": "MIT",
  "private": true,
  "repository": "https://github.com/arsalankhan-glitch/localize-sdk-react-native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "src/index.ts",
  "types": "lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json --outDir lib/module --module esnext --declaration false && tsc -p tsconfig.build.json --outDir lib/commonjs --module commonjs --declaration false && tsc -p tsconfig.build.json --outDir lib/typescript --emitDeclarationOnly && node scripts/fix-esm.js",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.71"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "19.1",
    "@types/react-test-renderer": "19.1",
    "jest": "^29.7.0",
    "react": "^19.3.0",
    "react-native": "^0.81.6",
    "react-test-renderer": "^19.3.0",
    "ts-jest": "^29.4.13",
    "typescript": "5.9"
  }
}
